[
  { "command": "Get-Help <cmd>", "description": "Show help for a command", "examples": ["Get-Help Get-Process", "Get-Help Copy-Item -Examples"] },
  { "command": "Get-Command", "description": "List available commands", "examples": ["Get-Command", "Get-Command -Noun Item"] },
  { "command": "Get-Process", "description": "List running processes", "examples": ["Get-Process", "Get-Process chrome"] },
  { "command": "Get-Service", "description": "List services", "examples": ["Get-Service", "Get-Service -Name wuauserv"] },
  { "command": "Get-ChildItem", "description": "List directory contents (like 'ls')", "examples": ["Get-ChildItem", "Get-ChildItem C:\\Users"] },
  { "command": "Set-Location <path>", "description": "Change directory (like 'cd')", "examples": ["Set-Location Downloads", "Set-Location C:\\Projects"] },
  { "command": "New-Item -ItemType File <name>", "description": "Create a new file", "examples": ["New-Item -ItemType File notes.txt", "New-Item -ItemType File index.html"] },
  { "command": "New-Item -ItemType Directory <name>", "description": "Create a new folder", "examples": ["New-Item -ItemType Directory Downloads", "New-Item -ItemType Directory Documents"] },
  { "command": "Copy-Item <src> <dest>", "description": "Copy a file or folder", "examples": ["Copy-Item notes.txt backup.txt", "Copy-Item -Recurse Documents Documents-backup"] },
  { "command": "Move-Item <src> <dest>", "description": "Move or rename a file or folder", "examples": ["Move-Item notes.txt Documents\\notes.txt", "Move-Item old-name.txt new-name.txt"] },
  { "command": "Remove-Item <path>", "description": "Delete a file or folder", "examples": ["Remove-Item notes.txt", "Remove-Item -Recurse OldFolder"] },
  { "command": "Select-String -Path <file> -Pattern <text>", "description": "Search text in files (like 'grep')", "examples": ["Select-String -Path log.txt -Pattern \"error\"", "Select-String -Path *.ps1 -Pattern \"TODO\""] },
  { "command": "Get-Location", "description": "Show the current directory (like 'pwd')", "examples": ["Get-Location"] },
  { "command": "Get-Content <file>", "description": "Display the contents of a file (like 'cat')", "examples": ["Get-Content notes.txt", "Get-Content log.txt -Tail 10"] },
  { "command": "Set-Content <file> <text>", "description": "Write text to a file, replacing its contents", "examples": ["Set-Content notes.txt \"Hello\"", "Set-Content hello.txt \"first line\""] },
  { "command": "Add-Content <file> <text>", "description": "Append text to the end of a file", "examples": ["Add-Content notes.txt \"another line\""] },
  { "command": "Clear-Host", "description": "Clear the terminal screen", "examples": ["Clear-Host", "cls"] },
  { "command": "Write-Output <text>", "description": "Send text to the output so it can be piped or displayed", "examples": ["Write-Output \"Hello\"", "Write-Output 42"] },
  { "command": "Write-Host <text>", "description": "Print text straight to the console", "examples": ["Write-Host \"Hello, world!\"", "Write-Host \"Done\" -ForegroundColor Green"] },
  { "command": "Read-Host <prompt>", "description": "Ask the user to type a value", "examples": ["Read-Host \"Enter your name\"", "$name = Read-Host \"Name\""] },
  { "command": "$name = <value>", "description": "Store a value in a variable", "examples": ["$name = \"Alex\"", "$count = 10"] },
  { "command": "if ($x -gt 5) { }", "description": "Run code only when a condition is true", "examples": ["if ($age -ge 18) { Write-Host \"Adult\" }"] },
  { "command": "foreach ($item in $list) { }", "description": "Loop over every item in a collection", "examples": ["foreach ($file in Get-ChildItem) { $file.Name }"] },
  { "command": "for ($i = 0; $i -lt 5; $i++) { }", "description": "Repeat code a set number of times", "examples": ["for ($i = 0; $i -lt 5; $i++) { Write-Host $i }"] },
  { "command": "while ($x -gt 0) { }", "description": "Repeat code while a condition stays true", "examples": ["while ($count -gt 0) { $count-- }"] },
  { "command": "function Name { }", "description": "Define your own reusable command", "examples": ["function Greet { Write-Host \"Hi\" }", "function Add($a, $b) { $a + $b }"] },
  { "command": "Get-ChildItem -Recurse", "description": "List files in a folder and all its subfolders", "examples": ["Get-ChildItem -Recurse", "Get-ChildItem C:\\Projects -Recurse"] },
  { "command": "Get-ChildItem -Filter <pattern>", "description": "List only files that match a name pattern", "examples": ["Get-ChildItem -Filter *.txt", "Get-ChildItem -Recurse -Filter *.log"] },
  { "command": "Get-ChildItem -Force", "description": "List files including hidden ones", "examples": ["Get-ChildItem -Force"] },
  { "command": "Rename-Item <path> <newname>", "description": "Rename a file or folder", "examples": ["Rename-Item old.txt new.txt"] },
  { "command": "Test-Path <path>", "description": "Check whether a file or folder exists", "examples": ["Test-Path notes.txt", "Test-Path C:\\Projects"] },
  { "command": "Select-Object <property>", "description": "Pick which properties of an object to keep", "examples": ["Get-Process | Select-Object Name, Id", "Get-ChildItem | Select-Object -First 5"] },
  { "command": "Where-Object { <condition> }", "description": "Keep only items that match a condition", "examples": ["Get-Process | Where-Object { $_.CPU -gt 100 }", "Get-ChildItem | Where-Object { $_.Length -gt 1MB }"] },
  { "command": "Sort-Object <property>", "description": "Sort items by a property", "examples": ["Get-Process | Sort-Object CPU -Descending", "Get-ChildItem | Sort-Object Name"] },
  { "command": "ForEach-Object { }", "description": "Run a block of code on every item in a pipeline", "examples": ["1..5 | ForEach-Object { $_ * 2 }"] },
  { "command": "Measure-Object", "description": "Count items or calculate totals and averages", "examples": ["Get-ChildItem | Measure-Object", "Get-Content notes.txt | Measure-Object -Line"] },
  { "command": "Group-Object <property>", "description": "Group items that share the same property value", "examples": ["Get-Process | Group-Object Company"] },
  { "command": "Format-Table", "description": "Show output as a table", "examples": ["Get-Process | Format-Table Name, Id", "Get-Service | Format-Table -AutoSize"] },
  { "command": "Format-List", "description": "Show every property of an object as a list", "examples": ["Get-Process chrome | Format-List *"] },
  { "command": "Out-File <file>", "description": "Send command output into a file", "examples": ["Get-Process | Out-File processes.txt"] },
  { "command": "Export-Csv <file>", "description": "Save objects to a CSV file", "examples": ["Get-Process | Export-Csv processes.csv -NoTypeInformation"] },
  { "command": "Import-Csv <file>", "description": "Read a CSV file as a list of objects", "examples": ["Import-Csv students.csv"] },
  { "command": "Stop-Process -Name <name>", "description": "Stop a running program by name", "examples": ["Stop-Process -Name notepad", "Stop-Process -Id 1234"] },
  { "command": "Start-Process <program>", "description": "Launch a program", "examples": ["Start-Process notepad", "Start-Process chrome https://example.com"] },
  { "command": "Start-Service <name>", "description": "Start a Windows service", "examples": ["Start-Service -Name Spooler"] },
  { "command": "Stop-Service <name>", "description": "Stop a Windows service", "examples": ["Stop-Service -Name Spooler"] },
  { "command": "Get-Date", "description": "Show the current date and time", "examples": ["Get-Date", "Get-Date -Format \"yyyy-MM-dd\""] },
  { "command": "Test-Connection <host>", "description": "Check whether another computer can be reached (like 'ping')", "examples": ["Test-Connection google.com", "Test-Connection 8.8.8.8 -Count 2"] },
  { "command": "Invoke-WebRequest <url>", "description": "Download a web page or file", "examples": ["Invoke-WebRequest https://example.com", "Invoke-WebRequest https://example.com/file.zip -OutFile file.zip"] },
  { "command": "Compress-Archive -Path <src> -DestinationPath <zip>", "description": "Create a zip file from files or folders", "examples": ["Compress-Archive -Path Documents -DestinationPath docs.zip"] },
  { "command": "Expand-Archive -Path <zip> -DestinationPath <dir>", "description": "Extract a zip file", "examples": ["Expand-Archive -Path docs.zip -DestinationPath output"] },
  { "command": "Get-Alias", "description": "List the shortcut names for commands", "examples": ["Get-Alias", "Get-Alias ls"] },
  { "command": "Set-ExecutionPolicy <policy>", "description": "Change whether PowerShell scripts are allowed to run", "examples": ["Set-ExecutionPolicy RemoteSigned -Scope CurrentUser"] },
  { "command": "Get-Member", "description": "Show the properties and methods of an object", "examples": ["Get-Process | Get-Member", "\"text\" | Get-Member"] },
  { "command": "Update-Help", "description": "Download the latest help files for PowerShell", "examples": ["Update-Help"] },
  { "command": "Get-Help <cmd> -Examples", "description": "Show worked examples for a command", "examples": ["Get-Help Get-Process -Examples"] },
  { "command": "Get-Command -Module <name>", "description": "List the commands that belong to a module", "examples": ["Get-Command -Module Microsoft.PowerShell.Management"] },
  { "command": "$PSVersionTable", "description": "Show the version of PowerShell you are running", "examples": ["$PSVersionTable", "$PSVersionTable.PSVersion"] },
  { "command": "Get-History", "description": "List the commands you have run in this session", "examples": ["Get-History"] },
  { "command": "Get-Variable", "description": "List the variables currently defined", "examples": ["Get-Variable", "Get-Variable name"] },
  { "command": "Remove-Variable <name>", "description": "Delete a variable", "examples": ["Remove-Variable count"] },
  { "command": "$env:<NAME>", "description": "Read an environment variable", "examples": ["$env:PATH", "$env:USERNAME"] },
  { "command": "$array = @(1, 2, 3)", "description": "Create an array", "examples": ["$names = @(\"Alex\", \"Sam\")", "$empty = @()"] },
  { "command": "$array += <item>", "description": "Add an item to an array", "examples": ["$names += \"Jo\""] },
  { "command": "$array[0]", "description": "Get an array item by its position", "examples": ["$names[0]", "$names[-1]"] },
  { "command": "$hash = @{ key = value }", "description": "Create a hashtable of keys and values", "examples": ["$ages = @{ Alex = 14; Sam = 15 }", "$ages[\"Alex\"]"] },
  { "command": "1..10", "description": "Create a range of numbers", "examples": ["1..10", "1..5 | ForEach-Object { $_ * 2 }"] },
  { "command": "$_", "description": "Refer to the current item in a pipeline", "examples": ["Get-Process | Where-Object { $_.CPU -gt 10 }"] },
  { "command": "-eq / -ne", "description": "Compare whether two values are equal or not equal", "examples": ["$a -eq 5", "$name -ne \"Alex\""] },
  { "command": "-lt / -le / -ge", "description": "Compare numbers: less than, less or equal, greater or equal", "examples": ["$age -lt 18", "$score -ge 50"] },
  { "command": "-like <pattern>", "description": "Compare text using wildcards", "examples": ["$name -like \"A*\"", "$file -like \"*.txt\""] },
  { "command": "-match <regex>", "description": "Compare text using a regular expression", "examples": ["\"abc123\" -match \"\\d+\""] },
  { "command": "-and / -or / -not", "description": "Combine conditions with logic", "examples": ["($a -gt 1) -and ($b -lt 5)", "-not $done"] },
  { "command": "-contains <item>", "description": "Check whether an array contains a value", "examples": ["$names -contains \"Alex\""] },
  { "command": "-split / -join", "description": "Split a string into parts or join parts into a string", "examples": ["\"a,b,c\" -split \",\"", "$names -join \", \""] },
  { "command": "-replace <old>, <new>", "description": "Replace text in a string", "examples": ["\"cat\" -replace \"c\", \"b\""] },
  { "command": "\"Hello $name\"", "description": "Put a variable's value inside a string", "examples": ["\"Score: $score\"", "\"Total: $($a + $b)\""] },
  { "command": "$text.ToUpper()", "description": "Convert a string to capital letters", "examples": ["$name.ToUpper()", "$name.ToLower()"] },
  { "command": "$text.Length", "description": "Get the number of characters in a string", "examples": ["$name.Length"] },
  { "command": "$text.Substring(0, 3)", "description": "Get part of a string", "examples": ["\"computer\".Substring(0, 3)"] },
  { "command": "$text.Trim()", "description": "Remove spaces from both ends of a string", "examples": ["\"  hi  \".Trim()"] },
  { "command": "switch ($x) { }", "description": "Choose between many cases for one value", "examples": ["switch ($day) { \"Sat\" { \"Weekend\" } default { \"Weekday\" } }"] },
  { "command": "do { } while ($x -gt 0)", "description": "Run code once, then repeat while a condition is true", "examples": ["do { $n-- } while ($n -gt 0)"] },
  { "command": "break", "description": "Exit a loop early", "examples": ["if ($i -eq 5) { break }"] },
  { "command": "continue", "description": "Skip to the next round of a loop", "examples": ["if ($i % 2 -eq 0) { continue }"] },
  { "command": "try { } catch { }", "description": "Handle errors so the script keeps going", "examples": ["try { Get-Content missing.txt -ErrorAction Stop } catch { \"Not found\" }"] },
  { "command": "throw <message>", "description": "Stop with an error you choose", "examples": ["throw \"Age cannot be negative\""] },
  { "command": "param($a, $b)", "description": "Declare the inputs a script or function accepts", "examples": ["param([string]$Name, [int]$Age)"] },
  { "command": "return <value>", "description": "Send a value back from a function", "examples": ["function Square($n) { return $n * $n }"] },
  { "command": "[int]$x", "description": "Convert a value to a whole number", "examples": ["[int]\"42\"", "[double]\"3.14\""] },
  { "command": "$x.GetType()", "description": "Show the data type of a value", "examples": ["(5).GetType()", "\"hi\".GetType()"] },
  { "command": "Get-Random", "description": "Pick a random number or item", "examples": ["Get-Random -Maximum 10", "Get-Random -InputObject $names"] },
  { "command": "Start-Sleep -Seconds <n>", "description": "Pause for a number of seconds", "examples": ["Start-Sleep -Seconds 5", "Start-Sleep -Milliseconds 500"] },
  { "command": "Write-Error <message>", "description": "Report an error message", "examples": ["Write-Error \"File not found\""] },
  { "command": "Write-Warning <message>", "description": "Show a warning message", "examples": ["Write-Warning \"Disk space is low\""] },
  { "command": "Out-Null", "description": "Throw away a command's output", "examples": ["New-Item test.txt | Out-Null"] },
  { "command": "Tee-Object -FilePath <file>", "description": "Show output and save it to a file at the same time", "examples": ["Get-Process | Tee-Object -FilePath procs.txt"] },
  { "command": "ConvertTo-Json", "description": "Convert objects into JSON text", "examples": ["Get-Process | Select-Object -First 3 | ConvertTo-Json"] },
