  { "command": "Import-Clixml <file>", "description": "Load objects saved with Export-Clixml", "examples": ["Import-Clixml procs.xml"] },
  { "command": "[xml]$doc = Get-Content <file>", "description": "Read an XML file so you can browse it like objects", "examples": ["[xml]$doc = Get-Content data.xml"] },
  { "command": "Write-Verbose <message>", "description": "Show extra detail when -Verbose is used", "examples": ["Write-Verbose \"Processing file\" -Verbose"] },
  { "command": "Write-Progress", "description": "Show a progress bar", "examples": ["Write-Progress -Activity \"Copying\" -PercentComplete 50"] },
