[
  { "command": "pwd", "description": "Print the current working directory", "examples": ["pwd"] },
  { "command": "ls", "description": "List files in the current directory", "examples": ["ls", "ls Documents"] },
  { "command": "ls -l", "description": "List files in long format with details", "examples": ["ls -l", "ls -l Downloads"] },
  { "command": "ls -a", "description": "List all files, including hidden ones", "examples": ["ls -a"] },
  { "command": "cd <dir>", "description": "Change into the specified directory", "examples": ["cd Downloads", "cd Documents", "cd /var/www"] },
  { "command": "cd ..", "description": "Move up one directory level", "examples": ["cd .."] },
  { "command": "mkdir <dir>", "description": "Create a new directory", "examples": ["mkdir Downloads", "mkdir Documents", "mkdir project-1"] },
  { "command": "rmdir <dir>", "description": "Remove an empty directory", "examples": ["rmdir OldFolder", "rmdir temp"] },
  { "command": "touch <file>", "description": "Create an empty file", "examples": ["touch notes.txt", "touch index.html"] },
  { "command": "cp <src> <dest>", "description": "Copy a file or directory", "examples": ["cp notes.txt backup.txt", "cp -r Documents Documents-backup"] },
  { "command": "mv <src> <dest>", "description": "Move or rename a file or directory", "examples": ["mv notes.txt Documents/notes.txt", "mv old-name.txt new-name.txt"] },
  { "command": "rm <file>", "description": "Remove a file", "examples": ["rm notes.txt", "rm -r OldFolder"] },
  { "command": "cat <file>", "description": "Display the contents of a file", "examples": ["cat notes.txt", "cat /etc/hosts"] },
  { "command": "whoami", "description": "Show the current logged-in user", "examples": ["whoami"] },
  { "command": "uname -a", "description": "Show system and kernel information", "examples": ["uname -a"] },
  { "command": "df -h", "description": "Show disk space usage in human-readable format", "examples": ["df -h"] },
  { "command": "top", "description": "Display running processes and resource usage", "examples": ["top"] },
  { "command": "chmod <mode> <file>", "description": "Change file permissions", "examples": ["chmod 755 script.sh", "chmod +x deploy.sh"] },
  { "command": "chown <user>:<group> <file>", "description": "Change file ownership", "examples": ["chown alice:staff notes.txt", "chown -R www-data:www-data /var/www"] },
  { "command": "sudo <command>", "description": "Run a command as superuser", "examples": ["sudo apt update", "sudo mkdir /opt/app"] },
  { "command": "ping <host>", "description": "Test network connectivity to a host", "examples": ["ping google.com", "ping 8.8.8.8"] },
  { "command": "ip a", "description": "Show network interfaces and IP addresses", "examples": ["ip a"] },
  { "command": "grep <pattern> <file>", "description": "Search for a pattern inside a file", "examples": ["grep error log.txt", "grep -r TODO src/"] },
  { "command": "man <command>", "description": "Show the manual page for a command", "examples": ["man ls", "man grep"] }
]
