  { "command": "Restart-Computer", "description": "Restart the computer", "examples": ["Restart-Computer"] },
  { "command": "Stop-Computer", "description": "Shut down the computer", "examples": ["Stop-Computer"] },
  { "command": "Get-LocalUser", "description": "List the local user accounts", "examples": ["Get-LocalUser"] },
  { "command": "Get-Acl <path>", "description": "Show the permissions on a file or folder", "examples": ["Get-Acl notes.txt"] },
