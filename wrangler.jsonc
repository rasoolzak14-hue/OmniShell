{
  "name": "omnishell",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omnishell-auth",
      "database_id": "019d39fc-4ffc-4e47-af19-7f0f295f53af"
    }
  ]
}
