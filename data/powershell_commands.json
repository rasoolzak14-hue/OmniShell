  { "command": "Out-GridView", "description": "Show results in a window you can sort and filter", "examples": ["Get-Process | Out-GridView"] },
  { "command": "Out-String", "description": "Convert output into plain text", "examples": ["Get-Process | Out-String"] },
  { "command": "ConvertTo-Csv", "description": "Convert objects into CSV text", "examples": ["Get-Process | ConvertTo-Csv -NoTypeInformation"] },
  { "command": "ConvertTo-Html", "description": "Convert objects into an HTML table", "examples": ["Get-Process | ConvertTo-Html | Out-File procs.html"] },
